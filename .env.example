# Скопіюйте цей файл як .env і заповніть
PORT=3000
# Пароль до адмінки при першому запуску (потім змінюється в адмінці)
ADMIN_PASSWORD=змініть-мене
# Необов'язково: Telegram можна налаштувати і в адмінці
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Папка для бази даних і фото (на хостингу вкажіть постійний диск)
# DATA_DIR=/var/data

# Скопіюйте цей файл як .env і заповніть (на Render ці значення вписуються в Environment)
PORT=3000
# Пароль до адмінки при першому запуску (потім змінюється в адмінці)
ADMIN_PASSWORD=змініть-мене
# База Turso (turso.tech). Без цих двох рядків сайт працює з локальним файлом data/site.db
TURSO_DATABASE_URL=libsql://назва-бази-ваш-акаунт.turso.io
TURSO_AUTH_TOKEN=
